<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2: the cover fills the widget; title and a play button sit on a scrim. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/player_widget_background" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_shape_container" android:tint="@color/widgetBackground" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/player_widget_art" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/player_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:fontFamily="sans-serif" android:includeFontPadding="false" android:singleLine="true"
                android:text="@string/player_widget_name" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/player_widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:singleLine="true"
                android:text="@string/player_widget_empty" android:textColor="#D9FFFFFF" android:textSize="12sp" />
        </LinearLayout>
        <FrameLayout android:id="@+id/player_widget_play" android:layout_width="52dp" android:layout_height="52dp"
            android:layout_marginStart="8dp" android:contentDescription="@string/player_widget_play">
            <ImageView android:id="@+id/player_widget_play_shape" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitXY" android:src="@drawable/widget_shape_pill" android:tint="@color/widgetAccent" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/player_widget_play_icon" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center"
                android:src="@drawable/ic_widget_play" android:tint="@color/widgetOnAccent" android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
